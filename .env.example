# GEMINI_API_KEY: Optional, required for the server-side store assistant.
# Store the key in your local .env or deployment secret store, never in VITE_* variables.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Razorpay API credentials. Configure these in the server environment only.
# Never add the Key Secret to a VITE_* variable or expose it to browser code.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Supabase server credentials. Never expose the service-role key to browser code.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Comma-separated verified owner email addresses allowed into the dashboard.
ADMIN_EMAILS=""

# Public Supabase settings used by the browser for OTP authentication only.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
